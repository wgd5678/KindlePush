/* Kindle 推送助手 全局样式（SRS 4） */

QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 13px;
    color: #1d1d1f;
}

QMainWindow, QDialog {
    background: #f5f6fa;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #d8dae5;
    border-radius: 8px;
    padding: 7px 16px;
}
QPushButton:hover { border-color: #3964fe; color: #3964fe; }
QPushButton:pressed { background: #eef1ff; }
QPushButton:disabled { color: #a0a3b1; background: #f0f1f5; border-color: #e5e7ef; }

QPushButton#primaryBtn {
    background: #3964fe;
    color: #ffffff;
    border: none;
    font-weight: 600;
}
QPushButton#primaryBtn:hover { background: #2f57e8; }
QPushButton#primaryBtn:pressed { background: #2850d8; }
QPushButton#primaryBtn:disabled { background: #b9c6f7; color: #ffffff; }

QPushButton#miniBtn { padding: 3px 10px; font-size: 12px; border-radius: 6px; }

QTableWidget {
    background: #ffffff;
    alternate-background-color: #fafbfe;
    border: 1px solid #e3e5ee;
    border-radius: 8px;
    gridline-color: #eef0f6;
}
QHeaderView::section {
    background: #f2f4fa;
    border: none;
    border-bottom: 1px solid #e3e5ee;
    padding: 6px 8px;
    font-weight: 600;
}
QTableWidget::item { padding: 4px 6px; }
QTableWidget::item:selected { background: #e8edff; color: #1d1d1f; }

QGroupBox {
    border: 1px solid #e3e5ee;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 10px;
    background: #ffffff;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #3964fe;
}

QLineEdit, QSpinBox, QComboBox {
    border: 1px solid #d8dae5;
    border-radius: 6px;
    padding: 6px 8px;
    background: #ffffff;
    selection-background-color: #3964fe;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #3964fe; }
QLineEdit:disabled, QComboBox:disabled { background: #f0f1f5; color: #8a8d99; }

QRadioButton { spacing: 6px; }
QCheckBox { spacing: 6px; }

QProgressBar {
    border: 1px solid #d8dae5;
    border-radius: 7px;
    background: #eef0f6;
    text-align: center;
    min-height: 18px;
}
QProgressBar::chunk { background: #3964fe; border-radius: 6px; }

QListWidget {
    background: #ffffff;
    border: 1px solid #e3e5ee;
    border-radius: 8px;
    outline: none;
}
QListWidget::item { padding: 5px 8px; }
QListWidget::item:selected { background: #e8edff; color: #1d1d1f; }

QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #e3e5ee;
    border-radius: 8px;
    font-family: Consolas, "Microsoft YaHei UI", monospace;
}

QStatusBar { background: #eef0f6; }
QStatusBar::item { border: none; }

QLabel#hintLabel { color: #81858c; font-size: 12px; }
QLabel#titleLabel { font-size: 15px; font-weight: 600; }
QLabel#statusOk { color: #1a7f37; font-weight: 600; }
QLabel#statusErr { color: #cf222e; font-weight: 600; }

QToolTip {
    background: #2e3140;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}
